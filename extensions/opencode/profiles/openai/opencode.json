{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5-nano",
  "agent": {
    "product-owner": {
      "description": "Main coordinator for feature development workflow",
      "mode": "primary",
      "model": "gpt-6.1-sol",
      "fallback": [
        "gpt-6-astra"
      ],
      "permission": {
        "task": {
          "pm": "allow",
          "team-lead": "allow",
          "analyst": "allow",
          "developer": "allow",
          "qa": "allow",
          "devops-engineer": "allow",
          "instruction-reviewer": "allow",
          "memory-curator": "allow"
        }
      }
    },
    "pm": {
      "description": "Project Manager - coordinates workflow",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "fallback": [
        "openai/gpt-6-luna"
      ],
      "permission": {
        "task": {
          "team-lead": "allow",
          "analyst": "allow",
          "developer": "allow",
          "qa": "allow",
          "devops-engineer": "allow",
          "instruction-reviewer": "allow",
          "memory-curator": "allow"
        }
      }
    },
    "team-lead": {
      "description": "Team Lead - planning and code review",
      "mode": "all",
      "model": "gpt-6.1-sol",
      "fallback": [
        "gpt-6-astra"
      ],
      "permission": {
        "task": {
          "analyst": "allow",
          "developer": "allow",
          "qa": "allow",
          "devops-engineer": "allow",
          "instruction-reviewer": "allow",
          "memory-curator": "allow"
        }
      }
    },
    "developer": {
      "description": "Developer - implements code",
      "mode": "all",
      "model": "openai/gpt-6-terra",
      "fallback": [
        "openai/gpt-6-terra"
      ]
    },
    "devops-engineer": {
      "description": "DevOps Engineer - infrastructure, CI/CD, and platform reliability",
      "mode": "all",
      "model": "gpt-6.1-sol",
      "fallback": [
        "gpt-6-astra"
      ]
    },
    "instruction-reviewer": {
      "description": "Instruction Reviewer - post-task review of instruction effectiveness and tool discipline",
      "mode": "all",
      "model": "openai/gpt-6-luna",
      "fallback": [
        "openai/gpt-6-luna"
      ],
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "memory-curator": {
      "description": "Memory Curator - post-task memory hygiene recommendations without automatic writes",
      "mode": "all",
      "model": "openai/gpt-6-luna",
      "fallback": [
        "openai/gpt-6-luna"
      ],
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "qa": {
      "description": "QA Engineer - runs tests",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "fallback": [
        "openai/gpt-6-luna"
      ]
    },
    "analyst": {
      "description": "Analyst - requirements, contracts, and UX specification",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "fallback": [
        "openai/gpt-6-luna"
      ]
    },
    "plan": {
      "description": "Planning mode",
      "mode": "primary",
      "model": "gpt-6.1-sol",
      "fallback": [
        "gpt-6-astra"
      ]
    },
    "build": {
      "description": "Build mode",
      "mode": "primary",
      "model": "gpt-6.1-sol",
      "fallback": [
        "gpt-6-astra"
      ]
    }
  }
}
