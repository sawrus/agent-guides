{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-guides.local/schemas/catalog.schema.json",
  "title": "Agent Guides Docs Catalog",
  "type": "object",
  "required": [
    "version",
    "generated_from",
    "areas",
    "stats"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.4.0"
    },
    "generated_from": {
      "type": "string"
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area",
          "group",
          "spec",
          "summary",
          "agents_path",
          "rules",
          "skills",
          "workflows"
        ],
        "properties": {
          "area": {
            "type": "string",
            "description": "<group>/<spec>, e.g. devops/ci-cd"
          },
          "group": {
            "type": "string"
          },
          "spec": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "description": "First paragraph of the spec AGENTS.md"
          },
          "agents_path": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "description",
                "paths",
                "trigger",
                "path",
                "body"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Globs that load the rule; empty for a manual rule"
                },
                "trigger": {
                  "type": "string",
                  "description": "`manual` when the rule has no paths"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string"
                }
              },
              "anyOf": [
                {
                  "properties": {
                    "paths": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "properties": {
                    "trigger": {
                      "enum": [
                        "manual",
                        "always_on"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "description",
                "path",
                "body"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string"
                }
              }
            }
          },
          "workflows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "trigger",
                "name",
                "description",
                "workflow_path",
                "use_when",
                "avoid_when",
                "inputs",
                "outputs",
                "related_rules",
                "rule_refs",
                "uses_skills",
                "skill_refs",
                "checks",
                "artifacts",
                "steps",
                "body",
                "examples"
              ],
              "properties": {
                "trigger": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "workflow_path": {
                  "type": "string",
                  "minLength": 1
                },
                "use_when": {
                  "type": "string"
                },
                "avoid_when": {
                  "type": "string"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "related_rules": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rule_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "path"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "path": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "uses_skills": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "skill_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "path"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "path": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Commands that must pass (`checks:` frontmatter)"
                },
                "artifacts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Paths the task changes or creates (`artifacts:` frontmatter)"
                },
                "steps": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "object",
                    "required": [
                      "title",
                      "do",
                      "done_when"
                    ],
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "do": {
                        "type": "string",
                        "minLength": 1
                      },
                      "done_when": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "description": "`### N. Title` blocks with **Do:** and **Done when:**"
                },
                "body": {
                  "type": "string",
                  "description": "Raw body markdown, filled only when the steps could not be parsed"
                },
                "examples": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "`Example request:` lines from the workflow body"
                }
              }
            }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "rules",
        "skills",
        "workflows",
        "examples",
        "problems"
      ],
      "properties": {
        "rules": {
          "type": "integer",
          "minimum": 0
        },
        "skills": {
          "type": "integer",
          "minimum": 0
        },
        "workflows": {
          "type": "integer",
          "minimum": 0
        },
        "examples": {
          "type": "integer",
          "minimum": 0
        },
        "problems": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
