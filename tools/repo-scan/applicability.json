{
  "version": 1,
  "_comment": "Declarative rules. Guide ids are paths under areas/: <area>/<group>/<name> for areas/<area>/<group>/workflows/<name>.md or rules/<name>.md. repo_rules decide what applies to a repository. task_routing only orders candidate workflows per task kind; JEV makes the real choice per task.",
  "activity": {
    "window_days": 365,
    "archived_segments": ["archive", "archived", "deprecated", "attic"],
    "junk_segments": ["maintenance", "sandbox", "playground", "scratch", "tmp", "trash"],
    "junk_names": [],
    "junk_max_code_lines": 100,
    "docs_names": ["gitlab-profile", ".github", "profile"],
    "docs_min_doc_files": 2,
    "docs_min_doc_lines": 20,
    "docs_max_code_lines": 200,
    "docs_min_ratio": 2.0,
    "active_min_commits": 1,
    "active_min_commits_without_ci": 5
  },
  "_classes": "A rule applies to repositories whose class is in its `classes` (default: default_rule_classes). Classes outside guidance_classes get no guidance.",
  "guidance_classes": ["active", "stale", "docs"],
  "default_rule_classes": ["active", "stale"],
  "repo_rules": [
    {
      "id": "documentation",
      "classes": ["docs"],
      "when": {"code_lines": 0},
      "confidence": 0.85,
      "rules": ["software/general/readme-sync-guide", "software/general/git-workflow-guide"],
      "workflows": ["software/general/code-review-workflow"]
    },
    {
      "id": "baseline",
      "when": {"code_lines": 1},
      "confidence": 0.9,
      "rules": ["software/general/git-workflow-guide", "software/general/code-style-guide", "software/general/readme-sync-guide"],
      "workflows": ["software/general/code-review-workflow", "software/general/develop-feature"]
    },
    {
      "id": "makefile",
      "when": {"manifest": "makefile"},
      "confidence": 0.95,
      "rules": ["software/general/makefile-guide", "software/general/lint-format-guide"]
    },
    {
      "id": "gitlab-ci",
      "when": {"manifest": "gitlab-ci"},
      "confidence": 0.95,
      "rules": ["devops/ci-cd/pipeline-standards"],
      "workflows": ["devops/ci-cd/release-pipeline"]
    },
    {
      "id": "github-actions",
      "when": {"manifest": "github-actions"},
      "confidence": 0.95,
      "rules": ["devops/ci-cd/pipeline-standards"],
      "workflows": ["devops/ci-cd/release-pipeline"]
    },
    {
      "id": "no-ci",
      "when": {"all": [{"code_lines": 300}, {"not": {"any": [{"manifest": "gitlab-ci"}, {"manifest": "github-actions"}]}}]},
      "confidence": 0.7,
      "workflows": ["devops/ci-cd/release-pipeline"]
    },
    {
      "id": "docker-compose",
      "when": {"manifest": "docker-compose"},
      "confidence": 0.9,
      "rules": ["software/general/docker-compose-guide"]
    },
    {
      "id": "container",
      "when": {"manifest": "dockerfile"},
      "confidence": 0.9,
      "rules": ["devops/devsecops/container-security", "devops/ci-cd/supply-chain-security"]
    },
    {
      "id": "python",
      "when": {"language": "Python", "min_lines": 200},
      "confidence": 0.85,
      "rules": ["software/general/lint-format-guide", "software/general/code-style-guide"]
    },
    {
      "id": "python-web-service",
      "when": {"all": [{"language": "Python", "min_lines": 200}, {"dependency": "fastapi|flask|django|aiohttp|starlette|sanic|litestar|tornado|uvicorn|gunicorn"}]},
      "confidence": 0.9,
      "rules": ["software/backend/service-architecture", "software/backend/security", "software/backend/testing", "software/backend/api-contracts", "software/backend/service-telemetry"],
      "workflows": ["software/general/develop-feature", "software/general/debug-issue", "software/general/refactor-module"]
    },
    {
      "id": "async-python",
      "when": {"dependency": "aiohttp|asyncpg|aiokafka|httpx|anyio|aiomysql|aioredis|motor"},
      "confidence": 0.75,
      "rules": ["software/backend/service-architecture"]
    },
    {
      "id": "go-service",
      "when": {"language": "Go", "min_lines": 200},
      "confidence": 0.8,
      "rules": ["software/backend/service-architecture", "software/backend/testing"],
      "workflows": ["software/general/develop-feature", "software/general/debug-issue", "software/general/refactor-module"]
    },
    {
      "id": "database",
      "when": {"any": [{"dependency": "sqlalchemy|sqlmodel|asyncpg|psycopg2|psycopg2-binary|psycopg|alembic|django|aiomysql|pymysql|peewee|tortoise-orm|gorm\\.io/gorm|github\\.com/jackc/pgx.*|prisma|typeorm|sequelize"}, {"file": "**/alembic.ini"}, {"file": "alembic.ini"}]},
      "confidence": 0.85,
      "rules": ["software/backend/data_access"],
      "workflows": ["software/backend/add-migration"]
    },
    {
      "id": "background-jobs",
      "when": {"dependency": "celery|apscheduler|rq|dramatiq|arq|huey"},
      "confidence": 0.8,
      "rules": ["software/backend/service-architecture"]
    },
    {
      "id": "env-config",
      "when": {"manifest": "env"},
      "confidence": 0.85,
      "rules": ["software/backend/configuration", "software/security/secrets-policy"]
    },
    {
      "id": "internal-library",
      "when": {"relationship": "library", "direction": "in"},
      "confidence": 0.85,
      "rules": ["software/security/dependency-policy", "software/qa/test-strategy"],
      "workflows": ["software/general/refactor-module"]
    },
    {
      "id": "http-consumer",
      "when": {"relationship": "http", "direction": "out"},
      "confidence": 0.75,
      "rules": ["software/backend/api-contracts", "software/backend/service-architecture"],
      "workflows": ["software/general/debug-issue"]
    },
    {
      "id": "kafka",
      "when": {"any": [{"relationship": "kafka", "direction": "any"}, {"dependency": "kafka-python|aiokafka|confluent-kafka|faust|faust-streaming|kafkajs|github\\.com/segmentio/kafka-go"}]},
      "confidence": 0.8,
      "rules": ["software/data-engineering/schema-management", "software/data-engineering/pipeline-integrity"]
    },
    {
      "id": "grpc",
      "when": {"any": [{"manifest": "proto"}, {"relationship": "grpc", "direction": "any"}]},
      "confidence": 0.8,
      "rules": ["software/backend/api-contracts", "software/data-engineering/schema-management"]
    },
    {
      "id": "helm-kubernetes",
      "when": {"manifest": "helm"},
      "confidence": 0.9,
      "rules": ["devops/kubernetes/workload-security", "devops/kubernetes/resource-governance", "devops/kubernetes/cluster-standards"],
      "workflows": ["devops/kubernetes/debug-workload"]
    },
    {
      "id": "argocd-gitops",
      "when": {"manifest": "argocd"},
      "confidence": 0.9,
      "rules": ["devops/infrastructure/immutability"],
      "workflows": ["devops/ci-cd/release-pipeline", "devops/infrastructure/iac-change"]
    },
    {
      "id": "deployable-service",
      "when": {"all": [{"manifest": "dockerfile"}, {"any": [{"manifest": "gitlab-ci"}, {"manifest": "helm"}, {"relationship": "deploy", "direction": "in"}]}, {"code_lines": 300}]},
      "confidence": 0.75,
      "rules": ["devops/observability/golden-signals", "devops/sre/slo-policy"],
      "workflows": ["devops/sre/incident-response", "devops/ci-cd/release-pipeline"]
    },
    {
      "id": "infrastructure-as-code",
      "when": {"any": [{"file": "**/*.tf"}, {"file": "*.tf"}, {"file": "ansible.cfg"}, {"file": "**/ansible.cfg"}, {"file": "**/playbook*.yml"}, {"file": "playbook*.yml"}]},
      "confidence": 0.85,
      "rules": ["devops/infrastructure/iac-standards", "devops/infrastructure/secret-hygiene", "devops/infrastructure/state-management"],
      "workflows": ["devops/infrastructure/iac-change"]
    },
    {
      "id": "frontend",
      "when": {"dependency": "react|vue|svelte|@angular/core|next|nuxt|vite"},
      "confidence": 0.85,
      "rules": ["software/frontend/component-architecture", "software/frontend/quality", "software/frontend/accessibility", "software/frontend/performance"]
    },
    {
      "id": "ml",
      "when": {"dependency": "scikit-learn|sklearn|torch|tensorflow|xgboost|lightgbm|catboost|mlflow|transformers"},
      "confidence": 0.8,
      "rules": ["software/mlops/reproducibility", "software/mlops/model-governance", "software/mlops/data-integrity"]
    },
    {
      "id": "data-pipelines",
      "when": {"any": [{"dependency": "apache-airflow|dbt-core|pyspark|dagster|prefect"}, {"file": "dags/**"}]},
      "confidence": 0.8,
      "rules": ["software/data-engineering/pipeline-integrity", "software/data-engineering/data-governance", "software/data-engineering/pii-handling"],
      "workflows": ["devops/sre/incident-response"]
    },
    {
      "id": "has-tests",
      "when": {"any": [{"file": "tests/**"}, {"file": "test/**"}, {"file": "**/*_test.go"}]},
      "confidence": 0.8,
      "rules": ["software/qa/test-strategy", "software/qa/flakiness-policy"]
    },
    {
      "id": "no-tests",
      "when": {"all": [{"code_lines": 300}, {"not": {"any": [{"file": "tests/**"}, {"file": "test/**"}, {"file": "**/*_test.go"}, {"file": "**/test_*.py"}]}}]},
      "confidence": 0.7,
      "rules": ["software/qa/test-strategy"],
      "workflows": ["software/general/develop-feature"]
    }
  ],
  "task_routing": {
    "feature": ["software/general/develop-feature", "devops/infrastructure/iac-change"],
    "bugfix": ["software/general/debug-issue", "devops/kubernetes/debug-workload", "software/general/develop-feature"],
    "refactor": ["software/general/refactor-module", "software/general/code-review-workflow"],
    "tests": ["software/general/develop-feature"],
    "migration": ["software/backend/add-migration"],
    "ci-failure": ["devops/ci-cd/release-pipeline"],
    "release": ["devops/ci-cd/release-pipeline"],
    "incident": ["devops/sre/incident-response", "devops/kubernetes/debug-workload"],
    "review": ["software/general/code-review-workflow"],
    "onboarding": ["devops/ci-cd/release-pipeline"]
  }
}
